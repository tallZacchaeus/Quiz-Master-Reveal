# Environment Variables Example
# Copy this file to .env.local for local development
# DO NOT commit .env.local to git

# Database Connection (PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/quiz_master

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Google Sheets Integration (if using Replit)
REPL_IDENTITY=
REPLIT_CONNECTORS_HOSTNAME=

# For Production/Hosting Platforms:
# DATABASE_URL will be provided by the hosting platform's database service
# NODE_ENV=production
# PORT will be automatically assigned
# HOST=0.0.0.0
